#include <stdio.h>
#include <string.h>

int main() {
    char str[100][100], temp[100];
    int n, i, j;
    int comparisons = 0;

    printf("Enter number of strings: ");
    scanf("%d", &n);

    printf("Enter strings:\n");
    for (i = 0; i < n; i++)
        scanf("%s", str[i]);

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {

            comparisons++;

            if (strcmp(str[j], str[j + 1]) < 0) {
                strcpy(temp, str[j]);
                strcpy(str[j], str[j + 1]);
                strcpy(str[j + 1], temp);
            }
        }
    }

    printf("\nTotal comparisons = %d\n", comparisons);

    return 0;
}
