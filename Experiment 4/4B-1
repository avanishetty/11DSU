#include <stdio.h>
#include <string.h>

int main() {
    char arr[100][50], key[50];
    int n, low, high, mid, found = 0;

    printf("Enter number of strings: ");
    scanf("%d", &n);

    printf("Enter strings in descending alphabetical order:\n");
    for (int i = 0; i < n; i++) {
        scanf("%s", arr[i]);
    }

    printf("Enter string to search: ");
    scanf("%s", key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = (low + high) / 2;

        if (strcmp(arr[mid], key) == 0) {
            printf("String found at position %d\n", mid);
            found = 1;
            break;
        }
        else if (strcmp(key, arr[mid]) > 0) {
            high = mid - 1;
        }
        else {
            low = mid + 1;
        }
    }

    if (!found)
        printf("String not found\n");

    return 0;
}
