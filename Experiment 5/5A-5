#include <stdio.h>

int main() {
    int a[100], n, i, j, temp;
    int swapped;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    // Optimized Bubble Sort
    for (i = 0; i < n - 1; i++) {
        swapped = 0;

        for (j = 0; j < n - 1 - i; j++) {
            if (a[j] < a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;

                swapped = 1;
            }
        }

        // No swaps means array is already sorted
        if (swapped == 0)
            break;
    }

    printf("Array in descending order:\n");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
