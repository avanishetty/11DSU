#include <stdio.h>
#include <string.h>

int main() {
    char str[100][100], temp[100];
    int n, i, j, longest;

    printf("Enter number of strings: ");
    scanf("%d", &n);

    printf("Enter %d strings:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%s", str[i]);
    }

    // Sort strings in descending order
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (strcmp(str[j], str[j + 1]) < 0) {
                strcpy(temp, str[j]);
                strcpy(str[j], str[j + 1]);
                strcpy(str[j + 1], temp);
            }
        }
    }

    printf("\nStrings in descending order:\n");
    for (i = 0; i < n; i++) {
        printf("%s\n", str[i]);
    }
    longest = 0;

    for (i = 1; i < n; i++) {
        if (strlen(str[i]) > strlen(str[longest])) {
            longest = i;
        }
    }

    printf("\nLongest string = %s", str[longest]);
    printf("\nLength = %lu\n", strlen(str[longest]));

    return 0;
}
