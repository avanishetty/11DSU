#include <stdio.h>

int main() {
    int arr[100], n;
    int maxOR = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            int value = arr[i] | arr[j];

            if (value > maxOR)
                maxOR = value;
        }
    }

    printf("Maximum OR value = %d\n", maxOR);

    return 0;
}
