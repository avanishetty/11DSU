#include <stdio.h>

int main() {
    unsigned int num;
    int position;

    printf("Enter a number: ");
    scanf("%u", &num);

    printf("Enter bit position to toggle (0-based): ");
    scanf("%d", &position);

    num = num ^ (1U << position);

    printf("Number after toggling bit = %u\n", num);

    return 0;
}
